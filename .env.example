# Copy this file to .env.local and fill in real values.
# Get an API key at https://resend.com (free tier available).

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiry emails are delivered:
CONTACT_TO_EMAIL=enquiries@naturelifescience.com

# Verified sender (must be a domain verified in Resend, or use onboarding@resend.dev while testing):
CONTACT_FROM_EMAIL=Nature Life Science <enquiries@naturelifescience.com>
